      "default": "day_month",
      "options": [
        {
          "value": "day_month",
          "label": "26 OCT"
        },
        {
          "value": "month_day",
          "label": "OCT 26"
        },
        {
          "value": "weekday",
          "label": "MON 26"
        }
      ]
    },
    "show_week": {
      "type": "boolean",
      "label": "Show ISO week",
      "default": true
