{
  "format_version": 1,
  "version": 1,
  "fields": {
    "clock_24": {
      "type": "boolean",
      "label": "24-hour clock",
      "default": true
    },
    "show_date": {
      "type": "boolean",
      "label": "Show date",
      "default": true
    },
    "date_format": {
      "type": "enum",
