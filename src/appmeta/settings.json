      "default": {
        "mode": "fixed",
        "name": "Estoril",
        "lat": 38.7057,
        "lon": -9.3977
      }
    },
    "temperature_unit": {
      "type": "enum",
      "label": "Temperature",
      "default": "celsius",
      "options": [
        {
          "value": "celsius",
          "label": "Celsius"
        },
        {
          "value": "fahrenheit",
          "label": "Fahrenheit"
        }
      ]
    },
    "show_sunset": {
      "type": "boolean",
      "label": "Show sunset",
      "default": true
